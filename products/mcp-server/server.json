{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.COSAI-Labs/toolpipe-mcp-server",
  "description": "34 developer tools: JSON, QR, UUID, hash, DNS, Base64, regex, JWT, URL, and more",
  "repository": {
    "url": "https://github.com/COSAI-Labs/make-money-30day-challenge",
    "source": "github",
    "subfolder": "products/mcp-server"
  },
  "version": "1.1.0",
  "packages": [
    {
      "registryType": "docker",
      "identifier": "ghcr.io/cosai-labs/toolpipe-mcp-server",
      "version": "1.1.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "ToolPipe API key (optional)",
          "isRequired": false,
          "format": "string",
          "isSecret": true,
          "name": "TOOLPIPE_API_KEY"
        },
        {
          "description": "Custom API base URL",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "TOOLPIPE_BASE_URL"
        }
      ]
    }
  ]
}
