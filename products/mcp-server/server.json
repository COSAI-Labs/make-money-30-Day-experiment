{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.COSAI-Labs/toolpipe-mcp-server",
  "description": "34 developer tools: JSON, QR, UUID, hash, DNS, Base64, regex, JWT, URL, and more",
  "repository": {
    "url": "https://github.com/COSAI-Labs/make-money-30day-challenge",
    "source": "github",
    "subfolder": "products/mcp-server"
  },
  "version": "1.0.2",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@cosai-labs/toolpipe-mcp-server",
      "version": "1.0.2",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "ToolPipe API key for authenticated access (optional, get free key at /api-keys)",
          "isRequired": false,
          "format": "string",
          "isSecret": true,
          "name": "TOOLPIPE_API_KEY"
        },
        {
          "description": "Custom API base URL (default: https://assessing-scoop-authorities-sheet.trycloudflare.com)",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "TOOLPIPE_BASE_URL"
        }
      ]
    }
  ]
}
